{
  "name": "pi-agents",
  "description": "Durable, named agents for Pi: delegate tasks, compose agents into graphs, and watch them work.",
  "version": "0.30.0",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "subagents",
    "pi-durable"
  ],
  "author": "Matthias Vallentin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-agents.git"
  },
  "homepage": "https://github.com/mavam/pi-agents#readme",
  "bugs": {
    "url": "https://github.com/mavam/pi-agents/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "format": "bunx @biomejs/biome format --write src tests demo/provider.ts",
    "format:check": "bunx @biomejs/biome format src tests demo/provider.ts",
    "lint": "bunx @biomejs/biome lint src tests demo/provider.ts",
    "lint:fix": "bunx @biomejs/biome lint --write src tests demo/provider.ts",
    "biome:check": "bunx @biomejs/biome check src tests demo/provider.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run biome:check",
    "pi-main": "scripts/pi-main.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "file:./.pi-main/ai.tgz",
    "@earendil-works/pi-codemode": "file:./.pi-main/codemode.tgz",
    "@earendil-works/pi-coding-agent": "file:./.pi-main/coding-agent.tgz",
    "@earendil-works/pi-tui": "file:./.pi-main/tui.tgz",
    "@types/node": "^24.3.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src"
    ]
  },
  "dependencies": {
    "@earendil-works/chord": "file:./.pi-main/chord.tgz",
    "@earendil-works/pi-durable": "file:./.pi-main/durable.tgz"
  },
  "overrides": {
    "@earendil-works/chord": "file:./.pi-main/chord.tgz",
    "@earendil-works/pi-tui": "file:./.pi-main/tui.tgz",
    "@earendil-works/pi-telemetry": "file:./.pi-main/telemetry.tgz",
    "@earendil-works/pi-codemode": "file:./.pi-main/codemode.tgz",
    "@earendil-works/pi-mcp": "file:./.pi-main/mcp.tgz",
    "@earendil-works/pi-ai": "file:./.pi-main/ai.tgz",
    "@earendil-works/pi-durable": "file:./.pi-main/durable.tgz",
    "@earendil-works/pi-agent-core": "file:./.pi-main/agent.tgz",
    "@earendil-works/pi-coding-agent": "file:./.pi-main/coding-agent.tgz"
  }
}
